# Required
BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ # Telegram Bot API token
OWNER_ID=123456789 # Bot owner Telegram user ID
LOG_CHANNEL=-1001234567890 # Telegram Channel ID for logging events
DB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority # MongoDB connection URI

# Optional
AUTH_USERS=123456789 987654321 # Space-separated list of admin user IDs
DB_NAME=feedvackbot # MongoDB database name, default: feedvackbot
START_TEXT=Welcome to STD FeedVackBot! Please send your message. # Custom start message
DONATE_LINK=https://deepanshu.in/donate # Donation link for the bot
BROADCAST_AS_COPY=true # Default: true. Whether to forward broadcast messages as copy
